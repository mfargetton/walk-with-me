
<h1>Conversation</h1>

<% @conversation.messages.order(:created_at).each do |message| %>
  <p>
    <strong><%= message.role == "user" ? "Vous" : "IA" %> :</strong>
    <%= message.content %>
  </p>
<% end %>

<h3>Votre message</h3>

<%= form_with model: [@conversation, Message.new] do |f| %>
  <%= f.label :content, "Message" %>
  <%= f.text_area :content, required: true %>
  <%= f.submit "Envoyer" %>
<% end %>

<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Walk With Me" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Walk With Me">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
<div class="container">
<nav class="navbarelement">
  <ul>
    <li><%= link_to "Accueil", root_path %></li>
    <% if user_signed_in? %>
      <li><%= link_to "Mes randos", conversations_path %></li>
      <li><%= link_to "Nouvelle randonnée", new_randonnee_path %></li>
      <li><%= button_to "Déconnexion", destroy_user_session_path, method: :delete %></li>
    <% else %>
      <li><%= link_to "Connexion", new_user_session_path %></li>
    <% end %>
  </ul>
</nav>
</div>

    <%= yield %>
    <%# fonctionne avec devise pour le rendu des alertes. Code communiqué dans lors de l'installation de devise%>
     <p class="notice"><%= notice %></p>
       <p class="alert"><%= alert %></p>

  </body>
</html>
